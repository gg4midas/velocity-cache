msgid ""
msgstr ""
"Project-Id-Version: Velocity Cache 1.5.2\n"
"Report-Msgid-Bugs-To: \n"
"PO-Revision-Date: 2026-11-24 00:00+0000\n"
"Last-Translator: Velocity Cache\n"
"Language-Team: Chinese (Simplified)\n"
"Language: zh_CN\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"
"Plural-Forms: nplurals=2; plural=(n != 1);\n"

msgid "%1$s (%2$d succeeded, %3$d failed)"
msgstr "%1$s（成功 %2$d，失败 %3$d）"

msgid "0 means never expire, refreshing only when content changes. Maximum 2592000 seconds."
msgstr "0 表示永不过期，仅在内容变化时刷新。最大 2592000 秒。"

msgid "304 Conditional Requests"
msgstr "304 条件请求"

msgid "Above-the-Fold Images to Skip"
msgstr "首屏图片跳过数"

msgid "Add defer to external scripts; skip jQuery, scripts already async/defer/module, and scripts matching exclusion rules."
msgstr "为外链脚本添加 defer；jQuery、已有 async/defer/module 和排除规则中的脚本跳过。"

msgid "Add loading=lazy and decoding=async to images; skip images already having loading or no-lazy/skip-lazy markers."
msgstr "为图片添加 loading=lazy 与 decoding=async，已有 loading 或 no-lazy/skip-lazy 标记的图片跳过。"

msgid "Added %d URLs to the preload queue; WP-Cron will process them in batches."
msgstr "已加入 %d 个预加载 URL，将由 WP-Cron 分批处理。"

msgid "Asset Optimization"
msgstr "资源优化"

msgid "Asset Version"
msgstr "资源版本号"

msgid "Asset version incremented and cache purged."
msgstr "资源版本号已递增，缓存已清理。"

msgid "Async CSS Exclusions"
msgstr "CSS 异步排除"

msgid "Async Load Non-Critical CSS"
msgstr "异步加载非关键 CSS"

msgid "Automatic Preload"
msgstr "自动预加载"

msgid "Brotli / Gzip Pre-compression"
msgstr "Brotli / Gzip 预压缩"

msgid "Bump Asset Version"
msgstr "递增资源版本号"

msgid "Bumping the asset version makes browsers re-download CSS/JS. Continue?"
msgstr "递增资源版本号会让浏览器重新下载 CSS/JS，确认继续？"

msgid "CDN URL Rewriting"
msgstr "CDN 地址重写"

msgid "CSS Combination"
msgstr "CSS 合并"

msgid "CSS Minification"
msgstr "CSS 压缩"

msgid "Cache"
msgstr "缓存"

msgid "Cache Directory"
msgstr "缓存目录"

msgid "Cache Lifetime (Seconds)"
msgstr "缓存有效期（秒）"

msgid "Cache Logged-In Users"
msgstr "缓存已登录用户"

msgid "Cache Preloading"
msgstr "缓存预加载"

msgid "Cache Tools"
msgstr "缓存工具"

msgid "Cache URLs With Query Strings"
msgstr "缓存带查询参数的 URL"

msgid "Cache only GET requests from anonymous visitors; dynamic pages and addresses in exclusion rules are not cached."
msgstr "仅缓存匿名访客的 GET 请求；动态页面与排除规则中的地址不会缓存。"

msgid "Cache purged."
msgstr "缓存已清理。"

msgid "Combine local stylesheets into one versioned file per media attribute."
msgstr "按 media 属性把本地样式表合并为一个版本化文件。"

msgid "Conditional CSS Unloading"
msgstr "CSS 条件卸载"

msgid "Conditional CSS Unloading Rules"
msgstr "CSS 条件卸载规则"

msgid "Critical CSS"
msgstr "关键 CSS"

msgid "Delay Common Third-Party Scripts"
msgstr "延迟常见第三方脚本"

msgid "Delay JS Rules"
msgstr "Delay JS 规则"

msgid "Delay JS by Rules"
msgstr "按规则 Delay JS"

msgid "Delay only scripts matching the rules below; resume on first interaction or after 5 seconds."
msgstr "仅延迟下方规则匹配的脚本，首次交互或 5 秒后恢复执行。"

msgid "Delay reCAPTCHA, GTag/GTM, Google Ads, Facebook Pixel and Cloudflare Beacon; load on first interaction or after 5 seconds."
msgstr "延迟 reCAPTCHA、GTag/GTM、Google Ads、Facebook Pixel 与 Cloudflare Beacon；首次交互或 5 秒后加载。"

msgid "Directory Writable"
msgstr "目录可写"

msgid "Disabled"
msgstr "停用"

msgid "Do not cache when any listed cookie name is present, for example wordpress_logged_in_*."
msgstr "命中任意 Cookie 名时不缓存，例如 wordpress_logged_in_*。"

msgid "Enabled"
msgstr "启用"

msgid "Error Handling"
msgstr "错误处理"

msgid "Exclude CSS"
msgstr "排除 CSS"

msgid "Exclude Cookie Names"
msgstr "排除 Cookie 名"

msgid "Exclude JavaScript"
msgstr "排除 JavaScript"

msgid "Exclude URLs"
msgstr "排除 URL"

msgid "Exclusion Rules"
msgstr "排除规则"

msgid "External assets, module scripts, async/defer scripts and stylesheets containing @import are skipped automatically."
msgstr "站外资源、module 脚本、async/defer 脚本与包含 @import 的样式表会被自动跳过。"

msgid "Failed to replace cache file: %s"
msgstr "缓存文件替换失败：%s"

msgid "Failed to write cache file: %s"
msgstr "缓存文件写入失败：%s"

msgid "For example https://cdn.example.com, mapped to the origin root while keeping wp-content/wp-includes paths."
msgstr "例如 https://cdn.example.com，对应原站根路径并保留 wp-content/wp-includes 目录。"

msgid "Generate .br/.gz cache variants served according to Accept-Encoding; when extensions are unavailable, only supported formats are generated."
msgstr "生成 .br/.gz 缓存变体并按 Accept-Encoding 投递；扩展不可用时只生成可用格式。"

msgid "Generate static HTML and serve cache hits directly without loading the theme."
msgstr "生成静态 HTML，命中后直接输出，不加载主题。"

msgid "HTML Minification"
msgstr "HTML 压缩"

msgid "Image LazyLoad"
msgstr "图片 LazyLoad"

msgid "Isolate cache by user ID; also remove the login cookie exclusion rule. Use with care on personalized pages."
msgstr "按用户 ID 隔离缓存；还需移除登录 Cookie 排除规则。个性化页面请谨慎开启。"

msgid "JavaScript Minification"
msgstr "JavaScript 压缩"

msgid "Last Preload"
msgstr "上次预加载"

msgid "Last Purge"
msgstr "上次清理时间"

msgid "Lazy load iframes such as videos and maps."
msgstr "延迟加载视频、地图等 iframe。"

msgid "LazyLoad uses native browser support; Defer and Delay JS may change script timing. Test on each site."
msgstr "LazyLoad 使用浏览器原生能力；Defer 与 Delay JS 可能改变脚本时序，请逐站测试。"

msgid "Load non-excluded stylesheets without blocking rendering, with a noscript fallback; core theme styles are excluded by default."
msgstr "把非排除的样式表改为非阻塞加载，并提供 noscript 回退；核心主题样式默认排除。"

msgid "Loading Optimization"
msgstr "加载优化"

msgid "Log Errors"
msgstr "记录错误"

msgid "Log cache write failures and optimization errors for troubleshooting."
msgstr "记录缓存写入失败与优化异常，便于排查。"

msgid "Logs are written to wp-content/cache/velocity-cache/logs/errors.log and rotate automatically above 1 MB."
msgstr "日志写入 wp-content/cache/velocity-cache/logs/errors.log，超过 1 MB 自动轮转。"

msgid "Manual preload uses custom URLs or reads the sitemap; automatic preload queues URLs after a full purge."
msgstr "手动预加载可使用自定义 URL 或自动读取站点地图；自动预加载会在全量清理后后台建队。"

msgid "Match against the request path, for example /cart/* or /sitemap.xml."
msgstr "按请求路径匹配，例如 /cart/*、/sitemap.xml。"

msgid "Minify local scripts and inline scripts, skipping module/async/defer."
msgstr "压缩本地脚本与内联脚本，跳过 module/async/defer。"

msgid "Minify local stylesheets and inline styles."
msgstr "压缩本地样式表与内联 style。"

msgid "No"
msgstr "否"

msgid "None"
msgstr "暂无"

msgid "Off by default to avoid duplicate caches from parameters such as ?utm_."
msgstr "默认关闭，避免 ?utm_ 等参数产生大量重复缓存。"

msgid "One full internal URL per line. Leave blank to read wp-sitemap.xml or sitemap_index.xml; the homepage is always included."
msgstr "每行一个完整站内 URL。留空则读取 wp-sitemap.xml 或 sitemap_index.xml，并始终包含首页。"

msgid "One handle or URL rule per line with * and ? wildcards; no script is delayed when empty."
msgstr "每行一条 handle 或 URL 规则，支持 * 与 ?；留空时不会延迟任何脚本。"

msgid "One per line: handle | marker1, marker2. Keep the stylesheet when the page DOM contains any marker; otherwise remove it. Markers are case-insensitive and script/style contents are ignored."
msgstr "每行：handle | 标记1, 标记2。页面 DOM 含任一标记则保留该样式表，否则移除；标记不区分大小写，判断时忽略 script/style 内容。"

msgid "One rule per line with * and ? wildcards. CSS/JS rules accept a handle name or URL keyword."
msgstr "每行一条，支持 * 与 ? 通配符。CSS/JS 规则可写 handle 名或 URL 关键词。"

msgid "Optimized Asset Files"
msgstr "优化资源文件"

msgid "Optional. Critical above-the-fold CSS is injected into the head; do not include style tags."
msgstr "可选。填写首屏关键 CSS，会注入 head；不要包含 style 标签。"

msgid "Page Cache"
msgstr "页面缓存"

msgid "Page Cache Files"
msgstr "页面缓存文件"

msgid "Page cache, HTML/CSS/JS optimization and cache version management. All actions require manage_options and pass security checks."
msgstr "页面缓存、HTML/CSS/JS 优化与缓存版本管理。所有操作均需 manage_options 权限并通过安全校验。"

msgid "Preload Queue"
msgstr "预加载队列"

msgid "Preload URLs"
msgstr "预加载 URL"

msgid "Preload in batches via WP-Cron after a full purge, 5 URLs per batch, up to 200."
msgstr "全量清理后通过 WP-Cron 分批预加载，每批 5 个 URL，最多 200 个。"

msgid "Purge All Cache"
msgstr "清理全部缓存"

msgid "Purge Page Cache"
msgstr "清理页面缓存"

msgid "Purge all page cache?"
msgstr "确认清理所有页面缓存？"

msgid "Purge page cache and optimized assets? Files will be rebuilt on the next request."
msgstr "清理页面缓存与优化资源？文件会在下次请求时重建。"

msgid "Remove comments and extra whitespace while preserving pre/textarea/script/style."
msgstr "移除注释与多余空白，保留 pre/textarea/script/style。"

msgid "Rewrite only src/href of local static assets; page links, srcset and dynamic endpoints are untouched."
msgstr "仅重写本地静态资源的 src/href，不改页面链接、srcset 或动态端点。"

msgid "Save Settings"
msgstr "保存设置"

msgid "Script URL keywords excluded from minification."
msgstr "不压缩的脚本 URL 关键词。"

msgid "Selective Purge"
msgstr "关联清除"

msgid "Settings"
msgstr "设置"

msgid "Settings saved and page cache refreshed. Current asset version: v%d"
msgstr "设置已保存，页面缓存已刷新。当前资源版本：v%d"

msgid "Skip lazy loading for the first N images; default 2, maximum 20."
msgstr "前 N 张图片不延迟，默认 2，最大 20。"

msgid "Start Preload"
msgstr "开始预加载"

msgid "Status"
msgstr "运行状态"

msgid "Stylesheet handles or URL keywords excluded from minification/combination."
msgstr "不压缩/合并的样式表 handle 或 URL 关键词。"

msgid "Support ETag and Last-Modified, returning 304 when content is unchanged."
msgstr "支持 ETag 与 Last-Modified，内容未变化时返回 304。"

msgid "Unload a whole stylesheet when the page lacks all listed markers. This is full-file unloading; check each page type after enabling."
msgstr "按下方规则，在页面不包含对应标记时移除整个样式表；属于整文件卸载，启用后请检查各页面类型。"

msgid "Velocity Cache refreshed the page cache after a plugin %s."
msgstr "Velocity Cache 已因插件%s刷新页面缓存。"

msgid "Velocity Cache requires PHP 7.4 or higher; the plugin has stopped loading."
msgstr "Velocity Cache 需要 PHP 7.4 或更高版本，插件已停止加载。"

msgid "Velocity Cache settings"
msgstr "Velocity Cache 配置"

msgid "When editing a post, purge only the post, homepage and related archives; when off, purge all page cache."
msgstr "编辑文章时只清文章页、首页及关联归档；关闭则全站清页面缓存。"

msgid "Yes"
msgstr "是"

msgid "You are not allowed to access this page."
msgstr "你没有权限访问此页面。"

msgid "You are not allowed to perform this action."
msgstr "你没有权限执行此操作。"

msgid "activation"
msgstr "启用"

msgid "astra-theme-css is excluded by default; one handle or URL rule per line. Core layout styles must stay render-blocking."
msgstr "默认排除 astra-theme-css；每行一个 handle 或 URL 规则，核心布局样式必须保留阻塞加载。"

msgid "deactivation"
msgstr "停用"

